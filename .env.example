# ==============================================================================
# 🤖 Discord Bot 環境設定範本 (.env.example)
# 請複製本檔案為 .env 並填入相應的金鑰與設定（勿將真實金鑰提交至 Git）
# ==============================================================================

# ---------- Discord 核心設定 ----------
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_OWNER_ID=your_discord_user_id_here
DISCORD_OWNER_GUILD_ID=your_owner_guild_id_here

# ---------- Web 控制面板 (Panel) 設定 ----------
WEB_PORT=5000
FLASK_SECRET_KEY=your_random_secret_key_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:5000/callback

# ---------- 多供應商免費 AI 智慧閘道 (Multi-Provider Free LLM) ----------
# 系統具備全自動故障轉移（Automatic Failover）：遇 429 速率限制或端點逾時自動切換至下一順位。
# 圖片附件將自動優先調用支援多模態（Vision）的端點（如 Google Gemini / NVIDIA DeepSeek Flash）。

# 1. Groq (LPU 極速推理，預設開源旗艦模型 openai/gpt-oss-120b，免費 30 RPM / 14,400 RPD)
# 申請網址: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. NVIDIA NIM (大容量備援，支援圖文多模態 deepseek-ai/deepseek-v4.1-flash，免費 1,000 Credits)
# 申請網址: https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here

# 3. Mistral AI (突發備援，歐洲開源旗艦 ministral-8b-latest，免費 1 RPS)
# 申請網址: https://console.mistral.ai
MISTRAL_API_KEY=your_mistral_api_key_here

# 4. Google AI Studio (Gemini，圖文雙模態 & 長文本分析，預設 gemini-3.5-flash-lite，免費 15 RPM / 1,500 RPD)
# 申請網址: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
# 或支援使用:
# GOOGLE_API_KEY=AIzaSy_your_gemini_api_key_here

# 5. Kilo Code Gateway (可選備援通道，若未設定將自動略過)
# 申請網址: https://api.kilo.ai
KILO_API_KEY=

# ---------- 雙 Lavalink v4 公開節點設定（第 8 週：雙節點容錯，不自架） ----------
# 請填入兩個第三方公開 Lavalink v4 節點資訊（嚴禁將真實主機與密碼提交至 Git）。
# 若僅設定其中一組，機器人仍可降級為單節點模式運作；若未設定 NODE1 則向下相容讀取 LAVALINK_URI / LAVALINK_PASSWORD。
LAVALINK_NODE1_URI=
LAVALINK_NODE1_PASSWORD=
LAVALINK_NODE1_IDENTIFIER=node1

LAVALINK_NODE2_URI=
LAVALINK_NODE2_PASSWORD=
LAVALINK_NODE2_IDENTIFIER=node2

# 舊版單節點向下相容參數（選填，僅在未設定 LAVALINK_NODE1_URI 時生效）
# LAVALINK_URI=
# LAVALINK_PASSWORD=

# 節點連線與容錯微調參數（選填）
# LAVALINK_CONNECT_TIMEOUT=15
# LAVALINK_SEARCH_TIMEOUT=15
# NODE_HEALTH_CHECK_INTERVAL=30
# LAVALINK_RECONNECT_COOLDOWN=60
# EMPTY_VOICE_CHANNEL_TIMEOUT=60

# ---------- Spotify 歌單匯入（第 7 週，只讀公開資料；未設定則該功能自動停用）----------
# 注意：Spotify 政策要求 Development mode App 的擁有者需有 Premium，否則 API 會被拒絕
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# 可選：匯入並發數 / 單次上限 / 單首搜尋逾時（秒）
# IMPORT_CONCURRENCY=3
# IMPORT_MAX_TRACKS=200
# IMPORT_SEARCH_TIMEOUT=15
