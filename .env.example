# ==============================================================================
# 🤖 Discord Bot 環境設定範本 (.env.example)
# 請複製本檔案為 .env 並填入相應的金鑰與設定（勿將真實金鑰提交至 Git）
# ==============================================================================

# ---------- Discord 核心設定 ----------
DISCORD_TOKEN=your_discord_bot_token_here
OWNER_ID=your_discord_user_id_here
OWNER_GUILD_ID=your_owner_guild_id_here

# ---------- Web 控制面板 (Panel) 設定 ----------
WEB_PORT=5000
SECRET_KEY=your_random_secret_key_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:5000/callback

# ---------- 多供應商免費 AI 智慧閘道 (Multi-Provider Free LLM) ----------
# 系統具備全自動故障轉移（Automatic Failover）：遇 429 速率限制或端點逾時自動切換至下一順位。
# 圖片附件將自動優先調用支援多模態（Vision）的端點（如 Google Gemini）。

# 1. Groq (極速 LPU 推理，文字主力第一順位，免費 30 RPM / 14,400 RPD)
# 申請網址: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. Google AI Studio (Gemini 2.0 Flash，視覺多模態主力 & 文字備援，免費 15 RPM / 1,500 RPD)
# 申請網址: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
# 或支援使用:
# GOOGLE_API_KEY=AIzaSy_your_gemini_api_key_here

# 3. NVIDIA NIM (大容量備援，免費 1,000 Credits)
# 申請網址: https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here

# 4. Mistral AI (突發備援，免費實驗方案 1 RPS)
# 申請網址: https://console.mistral.ai
MISTRAL_API_KEY=your_mistral_api_key_here

# 5. Kilo Code Gateway (免金鑰應急兜底，每小時 200 次免費)
# 申請網址: https://api.kilo.ai (若未填寫將自動以 zero-key 模式提供免金鑰兜底備援)
KILO_API_KEY=
